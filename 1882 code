
var assignTasks = function(servers, tasks) {
    const result = [];

    class MinHeap {
        constructor(compare) {
            this.heap = [];
            this.compare = compare;
        }

        push(value) {
            const h = this.heap;
            h.push(value);

            let i = h.length - 1;

            while (i > 0) {
                let p = Math.floor((i - 1) / 2);

                if (this.compare(h[p], h[i]) <= 0) break;

                [h[p], h[i]] = [h[i], h[p]];
                i = p;
            }
        }

        pop() {
            const h = this.heap;
            const top = h[0];
            const last = h.pop();

            if (h.length > 0) {
                h[0] = last;
                let i = 0;

                while (true) {
                    let smallest = i;
                    let l = 2 * i + 1;
                    let r = 2 * i + 2;

                    if (l < h.length &&
                        this.compare(h[l], h[smallest]) < 0) {
                        smallest = l;
                    }

                    if (r < h.length &&
                        this.compare(h[r], h[smallest]) < 0) {
                        smallest = r;
                    }

                    if (smallest === i) break;

                    [h[i], h[smallest]] =
                        [h[smallest], h[i]];

                    i = smallest;
                }
            }

            return top;
        }

        peek() {
            return this.heap[0];
        }

        get size() {
            return this.heap.length;
        }
    }

    const available = new MinHeap((a, b) =>
        a[0] - b[0] || a[1] - b[1]
    );

    const busy = new MinHeap((a, b) =>
        a[0] - b[0] ||
        a[1] - b[1] ||
        a[2] - b[2]
    );

    // Add all servers
    for (let i = 0; i < servers.length; i++) {
        available.push([servers[i], i]);
    }

    let currentTime = 0;

    for (let i = 0; i < tasks.length; i++) {

        // Move time forward to the task's arrival
        currentTime = Math.max(currentTime, i);

        // Release all completed servers
        while (busy.size > 0 &&
               busy.peek()[0] <= currentTime) {

            const [time, weight, index] = busy.pop();
            available.push([weight, index]);
        }

        // Wait if every server is busy
        if (available.size === 0) {
            currentTime = busy.peek()[0];

            // Release every server finishing at this time
            while (busy.size > 0 &&
                   busy.peek()[0] <= currentTime) {

                const [time, weight, index] = busy.pop();
                available.push([weight, index]);
            }
        }

        // Choose server with lowest weight and index
        const [weight, index] = available.pop();

        result.push(index);

        // Assign task and calculate finishing time
        busy.push([
            currentTime + tasks[i],
            weight,
            index
        ]);
    }

    return result;
};
